# ============================================
# Beacon Environment Variables (open-source build)
# ============================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# ------ Required ------

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
WORKER_PORT=3001

# Postgres (Docker compose maps changeme-postgres into the beacon DB)
DB_PASSWORD=changeme-postgres
DATABASE_URL=postgresql://beacon:changeme-postgres@localhost:5432/beacon

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme-redis

# IP hashing salt (anonymizes IP addresses in rate-limit keys)
IP_HASH_SALT=changeme-ip-salt

# Scan access tokens (HMAC-SHA256 signing for result URLs).
# Generate with: openssl rand -hex 32
SCAN_ACCESS_SECRET=changeme-scan-access-secret

# Report storage path — must be shared between web and worker containers
REPORT_STORAGE_PATH=/tmp/reports

# ------ Optional features (everything here is keyed; leave empty to disable) ------

# Claude — enables AI fix generation + semantic analysis + AI visibility prompts.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Additional AI providers for the AI-Visibility-Tracker
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
PERPLEXITY_API_KEY=

# Worker concurrency
WORKER_CONCURRENCY=5

# DLQ alerting (sliding-window thresholds, optional)
ALERT_FAILURE_THRESHOLD=5
ALERT_FAILURE_WINDOW_MS=600000
ALERT_FAILURE_COOLDOWN_MS=600000

# Outbound email (Resend). Leave RESEND_API_KEY unset to skip email sending.
# RESEND_API_KEY=re_xxx
EMAIL_FROM=Beacon <noreply@example.com>

# Sentry error tracking
# SENTRY_DSN=

# Plausible analytics
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ------ Production only ------
# DOMAIN=beacon.example.com
