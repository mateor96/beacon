# ============================================
# Beacon E2E Test Environment Variables
# ============================================
# Copy this file to .env.test and fill in the values
# cp .env.test.example .env.test

# ------ App ------
NODE_ENV=test
NEXT_PUBLIC_APP_URL=http://localhost:3000
WORKER_PORT=3001

# ------ Database (separate test DB) ------
DB_PASSWORD=changeme-postgres
DATABASE_URL=postgresql://beacon:changeme-postgres@localhost:5432/beacon_test

# ------ Redis ------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme-redis

# ------ CMS credential encryption (#223) ------
# Test-only key (32 bytes base64). DO NOT use in production.
CMS_CREDENTIALS_KEY=YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE=

# ------ Supabase Auth (required) ------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------ E2E Test User ------
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# ------ Report Storage ------
REPORT_STORAGE_PATH=/tmp/beacon-test-reports

# ------ GDPR ------
IP_HASH_SALT=test-salt
SCAN_ACCESS_SECRET=test-scan-access-secret

# Set to actual deploy timestamp; leave blank to disable legacy fallback
SCAN_ACCESS_LEGACY_CUTOFF=

# ------ Chromium (for PDF rendering in worker) ------
# Run: node -e "const {chromium}=require('@playwright/test');console.log(chromium.executablePath())"
# Paste the output here. globalSetup also auto-detects this in-process, but the worker
# runs as a separate process and needs the env var set explicitly.
CHROMIUM_PATH=

# ------ NOT required for E2E ------
# ANTHROPIC_API_KEY is NOT needed — report flow uses pre-seeded reportTexts
# STRIPE_* keys are NOT needed for E2E tests
