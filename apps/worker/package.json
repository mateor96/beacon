{
	"name": "@beacon/worker",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/server.js",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@beacon/queue": "workspace:*",
		"@beacon/shared": "workspace:*",
		"@beacon/db": "workspace:*",
		"@beacon/api-sdk": "workspace:*",
		"@beacon/scanner": "workspace:*",
		"@beacon/ai": "workspace:*",
		"@beacon/report": "workspace:*",
		"@beacon/monitoring": "workspace:*",
		"@beacon/notifications": "workspace:*",
		"bullmq": "^5.34.8",
		"drizzle-orm": "^0.38.3",
		"hono": "^4.6.16",
		"@hono/node-server": "^1.13.8"
	},
	"devDependencies": {
		"@types/node": "^22.10.7",
		"tsx": "^4.19.2",
		"typescript": "^5.7.3",
		"vitest": "^3.0.4"
	}
}
