{
	"name": "@beacon/shared",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"files": ["dist"],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"default": "./dist/types.js"
		},
		"./constants": {
			"types": "./dist/constants.d.ts",
			"default": "./dist/constants.js"
		},
		"./validation": {
			"types": "./dist/validation.d.ts",
			"default": "./dist/validation.js"
		},
		"./crypto-aes-gcm": {
			"types": "./dist/crypto-aes-gcm.d.ts",
			"default": "./dist/crypto-aes-gcm.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"disposable-email-domains": "^1.0.62",
		"zod": "^3.23.0"
	},
	"devDependencies": {
		"@types/node": "^22.10.7",
		"@vitest/coverage-v8": "^3.0.4",
		"typescript": "^5.7.3"
	}
}
