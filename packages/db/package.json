{
	"name": "@beacon/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./migrate": {
			"types": "./dist/migrate.d.ts",
			"default": "./dist/migrate.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"generate": "drizzle-kit generate",
		"migrate": "drizzle-kit migrate && tsx src/seed-rpc.ts",
		"db:migrate-run": "tsx src/migrate.ts",
		"db:seed-rpc": "tsx src/seed-rpc.ts",
		"clean": "rm -rf dist",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts"
	},
	"dependencies": {
		"@beacon/shared": "workspace:*",
		"drizzle-orm": "^0.38.3",
		"postgres": "^3.4.5"
	},
	"devDependencies": {
		"@types/node": "^22.10.7",
		"drizzle-kit": "^0.30.2",
		"tsx": "^4.19.0",
		"typescript": "^5.7.3",
		"vitest": "^3.0.0"
	}
}
